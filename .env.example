# Canonical Studio origin (no trailing slash). Used for auth base URL and absolute links.
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001

# Runtime: development | preview | production
APP_ENV=development

# PostgreSQL connection string (server-only). Required for auth and data.
DATABASE_URL=postgresql://user:password@localhost:5432/rurango_studio

# Better Auth — generate a long random secret (32+ chars). Never commit the real value.
BETTER_AUTH_SECRET=

# Optional override; defaults to NEXT_PUBLIC_STUDIO_URL
# BETTER_AUTH_URL=http://localhost:3001

# Owner bootstrap (used only by `npm run db:seed` in development)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Studio Owner
SEED_OWNER_PASSWORD=

# Default currency for future commercial documents (ISO 4217)
DEFAULT_CURRENCY=RWF

# Document upload policy
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Storage: local (dev default) or s3 (R2/S3-compatible for production)
STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH=.data/vault

# Required when STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rurango-studio-vault
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Read-only content publish API (Bearer token for web content:pull)
# Generate a long random string (16+ chars). Share only with the portfolio pull job.
# CMS_CONTENT_TOKEN=

# Backups (Phase 7)
# Protects POST /api/backups/run for scheduled jobs (16+ chars).
# BACKUP_CRON_SECRET=
# Optional dedicated backup bucket name (prefer ≠ primary vault bucket).
# BACKUP_S3_BUCKET=
# Retention target in days (align with storage lifecycle rules).
# BACKUP_RETENTION_DAYS=30

