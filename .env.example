# Canonical Studio origin (no trailing slash). Used for auth base URL and absolute links.
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001

# Runtime: development | preview | production
APP_ENV=development

# PostgreSQL connection string (server-only). Required for auth and data.
DATABASE_URL=postgresql://user:password@localhost:5432/rurango_studio

# Better Auth — generate a long random secret (32+ chars). Never commit the real value.
BETTER_AUTH_SECRET=

# Optional override; defaults to NEXT_PUBLIC_STUDIO_URL
# BETTER_AUTH_URL=http://localhost:3001

# Owner bootstrap (used only by `npm run db:seed` in development)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Studio Owner
SEED_OWNER_PASSWORD=

# Default currency for future commercial documents (ISO 4217)
DEFAULT_CURRENCY=RWF

# Document upload policy (enforced in later phases)
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
